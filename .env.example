# Facoltativo: PATH è sufficiente se gli strumenti sono già disponibili.
# Usare soltanto percorsi e strumenti del proprio computer.
FFMPEG_PATH=
FFPROBE_PATH=
NODE_PATH=
CHROME_PATH=
FONT_PATH=
# Cache/preparazione modelli. Default: work/cache dentro questo clone.
# Su PC con disco dati separato mettere clone e cache su quel disco.
CONTENT_MACHINE_CACHE=
# Nessuna chiave API è necessaria: Claude/Codex/altro agente scrive file JSON.
# I request/response contengono dati del video e devono restare locali.
LLM_EXCHANGE_DIR=
